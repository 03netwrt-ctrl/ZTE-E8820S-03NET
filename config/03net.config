# 03NET firmware config for ZTE E8820S (ramips/mt7621)
# Minimal config — the rest is filled in by `make defconfig` during the build.
CONFIG_TARGET_ramips=y
CONFIG_TARGET_ramips_mt7621=y
CONFIG_TARGET_ramips_mt7621_DEVICE_zte_e8820s=y

# Branding: distribution name shown in /etc/openwrt_release and LuCI
CONFIG_VERSIONOPT=y
CONFIG_VERSION_DIST="03NET"

# --- Terminal (ttyd) ---
CONFIG_PACKAGE_luci-app-ttyd=y

# --- File manager (TinyFM by bobbyunknown) ---
CONFIG_PACKAGE_luci-app-tinyfm=y

# --- Modem drivers ---
CONFIG_PACKAGE_kmod-usb-serial=y
CONFIG_PACKAGE_kmod-usb-serial-option=y
CONFIG_PACKAGE_kmod-usb-serial-qualcomm=y
CONFIG_PACKAGE_kmod-usb-serial-sierrawireless=y
CONFIG_PACKAGE_kmod-usb-serial-wwan=y
CONFIG_PACKAGE_kmod-usb-net=y
CONFIG_PACKAGE_kmod-usb-net-qmi-wwan=y
CONFIG_PACKAGE_kmod-usb-net-mbim=y
CONFIG_PACKAGE_kmod-usb-net-rndis=y
CONFIG_PACKAGE_kmod-usb-net-cdc-ncm=y
CONFIG_PACKAGE_kmod-usb-net-huawei-cdc-ncm=y
CONFIG_PACKAGE_usb-modeswitch=y
CONFIG_PACKAGE_luci-proto-modemmanager=y
CONFIG_PACKAGE_modemmanager=y
CONFIG_PACKAGE_luci-app-sms-tool=y

# --- USB storage ---
CONFIG_PACKAGE_kmod-usb-storage=y
CONFIG_PACKAGE_block-mount=y
