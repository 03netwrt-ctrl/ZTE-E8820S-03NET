# 03NET default settings for ZTE E8820S
# Beware! This script will be in /rom/etc/uci-defaults/ as part of the image.
# It runs once at first boot.

# --- Root password: "ikan" (SHA-512 hash, generated at build config time) ---
sed -i 's|^root:[^:]*:|root:$6$TPPSmQ5JdhVHOdr4$MRDAJic1llCjcrzo9H3bwwn.ohlQsks7Kw6I.sqvCS7FXQegVfMRWn7wSHr2a0DlkgaAzYcqbRcG66AOu.ZjQ1:|' /etc/shadow

# --- Hostname branding ---
uci set system.@system[0].hostname='03NET-E8820S'
uci commit system

# --- Default LuCI theme: material ---
if uci -q get luci.themes.Material >/dev/null 2>&1; then
  uci set luci.main.mediaurlbase='/luci-static/material'
  uci commit luci
fi

# --- Firmware version branding: "OpenWrt 24.10.8 | 03NET" ---
if [ -f /etc/openwrt_release ]; then
  . /etc/openwrt_release
  if [ -n "$DISTRIB_RELEASE" ]; then
    sed -i "s|^DISTRIB_DESCRIPTION=.*|DISTRIB_DESCRIPTION='OpenWrt $DISTRIB_RELEASE \| 03NET'|" /etc/openwrt_release
  fi
fi

# --- TinyFM: let uhttpd execute PHP via php-cgi ---
# Without this, opening TinyFM makes the browser download index.php
# ("Save As" dialog) instead of showing the file manager.
if [ -x /usr/bin/php-cgi ]; then
  if ! uci -q get uhttpd.main.interpreter 2>/dev/null | grep -q "php-cgi"; then
    uci add_list uhttpd.main.interpreter='.php=/usr/bin/php-cgi'
    uci commit uhttpd
    /etc/init.d/uhttpd restart >/dev/null 2>&1
  fi
fi

# --- TinyFM: no password, straight in + rootfs symlink ---
# Disable TinyFM's own login (LuCI already requires auth)
if uci -q get tinyfm.auth.enable >/dev/null 2>&1; then
  uci set tinyfm.auth.enable='0'
  uci commit tinyfm
fi
# Make sure the rootfs symlink exists (fixes 'Root path not found')
# Use ln -sf directly: more robust than tinyfm.sh across installs
if [ -d /www/tinyfm ]; then
  ln -sf / /www/tinyfm/rootfs
fi

# --- ttyd: skip login prompt, straight to root shell ---
for _s in $(uci show ttyd 2>/dev/null | sed -n 's/^ttyd\.\([^.=]*\)=ttyd/\1/p'); do
  uci set ttyd.$_s.command='/bin/sh -l'
done
uci commit ttyd 2>/dev/null

# --- 03NET dashboard: activate circle-gauge overview ---
# (backs up stock status includes; idempotent — safe to run twice)
for _f in /www/luci-static/resources/view/status/include/10_system.js \
          /www/luci-static/resources/view/status/include/20_memory.js \
          /www/luci-static/resources/view/status/include/25_storage.js \
          /www/luci-static/resources/view/status/include/29_ports.js \
          /www/luci-static/resources/view/status/include/30_network.js \
          /www/luci-static/resources/view/status/include/40_dhcp.js \
          /www/luci-static/resources/view/status/include/60_wifi.js; do
  [ -f "$_f" ] && mv "$_f" "$_f.bak"
done

# --- 03NET login banner (ttyd / SSH) ---
chmod +x /etc/03net-motd.sh 2>/dev/null
if ! grep -q "03net-motd" /etc/profile 2>/dev/null; then
  printf '\n[ -x /etc/03net-motd.sh ] && /etc/03net-motd.sh\n' >> /etc/profile
fi

# --- WiFi: 2.4GHz = 03NET-WRT, 5GHz = 03NET-WRT 5G ---
# NOTE: WPA2 needs at least 8 characters!
wlan_password="03netwrt"

if [ -n "$wlan_password" -a ${#wlan_password} -ge 8 ]; then
  for dev in $(uci show wireless 2>/dev/null | sed -n 's/^wireless\.\([^.=]*\)=wifi-device/\1/p'); do
    band="$(uci -q get wireless.$dev.band)"
    case "$band" in
      2g) ssid="03NET-WRT" ;;
      5g) ssid="03NET-WRT 5G" ;;
      *)  ssid="03NET-WRT" ;;
    esac
    for iface in $(uci show wireless 2>/dev/null | sed -n 's/^wireless\.\([^.=]*\)=wifi-iface/\1/p'); do
      [ "$(uci -q get wireless.$iface.device)" = "$dev" ] || continue
      # More options: https://openwrt.org/docs/guide-user/network/wifi/basic
      uci set wireless.$iface.disabled='0'
      uci set wireless.$iface.encryption='psk2'
      uci set wireless.$iface.ssid="$ssid"
      uci set wireless.$iface.key="$wlan_password"
    done
    # Enable the radio itself (this was missing — wifi stayed dead without it)
    uci set wireless.$dev.disabled='0'
    # Country code Indonesia (required for 5G channels to work)
    uci set wireless.$dev.country='ID'
    # 5G: use channel 149 (tested working: 48, 149, 161)
    if [ "$band" = "5g" ]; then
      uci set wireless.$dev.channel='149'
    fi
  done
  uci commit wireless
fi

echo "All done!"
