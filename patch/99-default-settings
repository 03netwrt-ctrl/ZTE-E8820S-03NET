# 03NET default settings for ZTE E8820S
# Beware! This script will be in /rom/etc/uci-defaults/ as part of the image.
# It runs once at first boot.

# --- Root password: "ikan" (SHA-512 hash, generated at build config time) ---
sed -i 's|^root:[^:]*:|root:$6$TPPSmQ5JdhVHOdr4$MRDAJic1llCjcrzo9H3bwwn.ohlQsks7Kw6I.sqvCS7FXQegVfMRWn7wSHr2a0DlkgaAzYcqbRcG66AOu.ZjQ1:|' /etc/shadow

# --- Hostname branding ---
uci set system.@system[0].hostname='03NET-E8820S'
uci commit system

# --- Default LuCI theme: material ---
if uci -q get luci.themes.Material >/dev/null 2>&1; then
  uci set luci.main.mediaurlbase='/luci-static/material'
  uci commit luci
fi

# --- 03NET login banner (ttyd / SSH) ---
chmod +x /etc/03net-motd.sh 2>/dev/null
if ! grep -q "03net-motd" /etc/profile 2>/dev/null; then
  printf '\n[ -x /etc/03net-motd.sh ] && /etc/03net-motd.sh\n' >> /etc/profile
fi

# --- WiFi: 2.4GHz = 03NET-WRT, 5GHz = 03NET-WRT 5G ---
# NOTE: WPA2 needs at least 8 characters!
wlan_password="03netwrt"

if [ -n "$wlan_password" -a ${#wlan_password} -ge 8 ]; then
  for dev in $(uci show wireless 2>/dev/null | sed -n 's/^wireless\.\([^.=]*\)=wifi-device/\1/p'); do
    band="$(uci -q get wireless.$dev.band)"
    case "$band" in
      2g) ssid="03NET-WRT" ;;
      5g) ssid="03NET-WRT 5G" ;;
      *)  ssid="03NET-WRT" ;;
    esac
    for iface in $(uci show wireless 2>/dev/null | sed -n 's/^wireless\.\([^.=]*\)=wifi-iface/\1/p'); do
      [ "$(uci -q get wireless.$iface.device)" = "$dev" ] || continue
      # More options: https://openwrt.org/docs/guide-user/network/wifi/basic
      uci set wireless.$iface.disabled='0'
      uci set wireless.$iface.encryption='psk2'
      uci set wireless.$iface.ssid="$ssid"
      uci set wireless.$iface.key="$wlan_password"
    done
    # Enable the radio itself (this was missing — wifi stayed dead without it)
    uci set wireless.$dev.disabled='0'
  done
  uci commit wireless
fi

echo "All done!"
